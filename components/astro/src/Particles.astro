---
import type { Container, Engine, ISourceOptions } from "@tsparticles/engine";

export interface IParticlesProps {
    id: string;
    options?: ISourceOptions;
    url?: string;
    class?: string;
    style?: string;
}

const { id, options, url, class: className, style } = Astro.props as IParticlesProps;
---
<astro-particles class={className} style={style} data-id={id} data-options={options ? JSON.stringify(options) : undefined} data-url={url}>
    <canvas></canvas>
</astro-particles>

<script>
    import { tsParticles } from "@tsparticles/engine";

    class AstroParticles extends HTMLElement {
        constructor() {
            super();

            (async () => {
                const rawOptions = this.dataset.options;
                const options = rawOptions ? JSON.parse(rawOptions) : undefined;

                await tsParticles.load({
                    id: this.dataset.id,
                    options,
                    url: this.dataset.url
                });
            })();
        }
    }

    if (!customElements.get("astro-particles")) {
        customElements.define("astro-particles", AstroParticles);
    }
</script>
